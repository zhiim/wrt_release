# Keep the existing multi-profile build, selecting Athena (RE-CS-02) only.
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=n
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=n
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=n

# Apply after the original device, base and optional package configurations.
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_luci-app-easytier=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-vlmcsd=n

# Do not let translations reselect the excluded applications.
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=n
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=n
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=n
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=n
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=n
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=n
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=n
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=n
CONFIG_PACKAGE_luci-i18n-vlmcsd-zh-cn=n

# Excluded applications' services/data; defconfig retains shared dependencies.
CONFIG_PACKAGE_adguardhome=n
CONFIG_PACKAGE_easytier=n
CONFIG_PACKAGE_lucky=n
CONFIG_PACKAGE_mosdns=n
CONFIG_PACKAGE_geo2txt=n
CONFIG_PACKAGE_appfilter=n
CONFIG_PACKAGE_kmod-oaf=n
CONFIG_PACKAGE_samba4-server=n
CONFIG_PACKAGE_smartdns=n
CONFIG_PACKAGE_smartdns-ui=n
CONFIG_PACKAGE_vlmcsd=n
CONFIG_PACKAGE_chinadns-ng=n
CONFIG_PACKAGE_dns2socks=n
CONFIG_PACKAGE_ipt2socks=n
CONFIG_PACKAGE_microsocks=n
CONFIG_PACKAGE_tcping=n
CONFIG_PACKAGE_geoview=n
CONFIG_PACKAGE_v2dat=n
CONFIG_PACKAGE_v2ray-geoip=n
CONFIG_PACKAGE_v2ray-geosite=n
CONFIG_PACKAGE_xray-core=n

# The original nss/docker_deps fragments remain unchanged; install Docker.
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y

# Keep both the original QuickFile/Nginx stack and the basic LuCI collection.
# nginx-luci-support disables uhttpd to avoid competing for the same ports.
CONFIG_PACKAGE_luci-light=y

# XFRM/IPsec and CBC/HMAC/SHA1 come from the existing vowifi fragment.
CONFIG_PACKAGE_ip-full=y

# Quectel EC20 USB AT ports and QMI mobile broadband.
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y
